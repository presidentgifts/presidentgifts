# Copy to .env.local and fill in. Never commit real values.

# ---------- Database (Neon Postgres) ----------
# Neon dashboard → Connect → "Pooled connection". Choose region Frankfurt (aws-eu-central-1).
# For local development run `npm run db:local` and use:
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
DATABASE_URL=

# ---------- File storage (Cloudflare R2) ----------
# Cloudflare dashboard → R2 → Create bucket, then "Manage API tokens" (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL or custom domain, e.g. https://media.presidentgift.com
R2_PUBLIC_URL=

# ---------- Site data source ----------
# "local" (default): the site reads from this app's database.
# "legacy": the site reads from the old backend (BASE_URL). See README, "Moving the site to the new system".
STOREFRONT_DATA_SOURCE=local
# Country the site opens in for visitors from other countries (country list "default").
DEFAULT_COUNTRY=UZ

# ---------- Copying data from the old backend (npm run migrate:legacy) ----------
# Defaults: BASE_URL + "/api/v1" and NEXT_PUBLIC_ADMIN_URL.
LEGACY_API_URL=
LEGACY_MEDIA_URL=

# ---------- Admin bootstrap ----------
# Optional: password for `npm run admin:create`. If empty, a password is generated.
ADMIN_PASSWORD=

# ---------- Storefront (current) ----------
# Server-side names are preferred; the NEXT_PUBLIC_* versions still work but are deprecated.
BASE_URL=
BASIC_ADMIN=
BASIC_PASSWORD=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_ADMIN_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMOVE_BG_API_KEY=
IPINFO_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_SUBDOMAIN=
AMOCRM_REDIRECT_URI=
AMOCRM_AUTHORIZATION_CODE=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
